{
  "version": "v1",
  "hooks": [
    {
      "name": "swiftlint-on-save",
      "trigger": "PostFileSave",
      "matcher": "\\\\.swift$",
      "action": {
        "type": "command",
        "command": "{{swiftlint lint --quiet --strict}}"
      },
      "timeout": 60,
      "enabled": true
    }
  ]
}
